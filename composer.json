{
    "name": "kdbaustert/dotsnitch",
    "description": "Finds where your Mac and your dotfiles have drifted apart, and asks before fixing anything.",
    "keywords": ["dotfiles", "macos", "homebrew", "brewfile", "symlinks", "cli"],
    "homepage": "https://github.com/kdbaustert/dotsnitch",
    "type": "project",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/kdbaustert/dotsnitch/issues",
        "source": "https://github.com/kdbaustert/dotsnitch"
    },
    "authors": [
        {
            "name": "Kenny B",
            "email": "kenny@kennyb.dev"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel-zero/foundation": "^13.23",
        "laravel-zero/framework": "^13.0",
        "laravel/prompts": "^0.3.27",
        "symfony/process": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "require-dev": {
        "laravel/pint": "^1.30.4",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^4.7.8 || ^5.0.3",
        "phpstan/phpstan": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "bin": ["dotsnitch"],
    "scripts": {
        "lint": "pint --test",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "format": "pint",
        "test": "pest --compact",
        "build": [
            "Composer\\Config::disableProcessTimeout",
            "scripts/build.sh"
        ]
    }
}
